<Project>
    <ItemGroup Condition="'$(LegacyAutoCAD)' == 'true'">
        <!-- Source-only compatibility APIs; no extra Polyfill runtime DLL. -->
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    </ItemGroup>

    <Target Name="ValidateAutoCADConfiguration" BeforeTargets="PrepareForBuild"
            Condition="'$(MSBuildProjectName)' == 'AutoBIMFusion.Plugin' Or '$(MSBuildProjectName)' == 'AutoBIMFusion.Common' Or '$(MSBuildProjectName)' == 'AutoBIMFusion.Merge' Or '$(MSBuildProjectName)' == 'AutoBIMFusion.QuickPdf'">
        <Error Condition="'$(AcadVersion)' == ''"
               Text="Select an AutoCAD configuration: DebugA19–DebugA27 or ReleaseA19–ReleaseA27." />
    </Target>
</Project>
