<Project Sdk="WixToolset.Sdk/4.0.6">
    <PropertyGroup>
        <OutputType>Package</OutputType>
        <InstallerPlatform>x64</InstallerPlatform>
        <Platform>x64</Platform>
        <Pedantic>true</Pedantic>
        <SuppressIces>ICE61</SuppressIces>
        <Version Condition="'$(Version)' == ''">1.0.0</Version>
        <DefineConstants>$(DefineConstants);Version=$(Version)</DefineConstants>
        <PayloadDir Condition="'$(PayloadDir)' == ''">$(RepoRoot)out\installer\payload\AutoBIMFusion.bundle</PayloadDir>
        <PayloadDirSlash>$(PayloadDir.Replace('\', '/'))</PayloadDirSlash>
        <OutputName>AutoBIMFusion</OutputName>
        <BaseOutputPath>bin\</BaseOutputPath>
        <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
        <PublishMsiDir>$(RepoRoot)out\installer\</PublishMsiDir>
        <PluginProject>$(RepoRoot)src\AutoBIMFusion.Plugin\AutoBIMFusion.Plugin.csproj</PluginProject>
        <PayloadBuildType Condition="'$(Configuration)' == 'Debug' Or $([System.String]::Copy('$(Configuration)').StartsWith('Debug'))">Debug</PayloadBuildType>
        <PayloadBuildType Condition="'$(PayloadBuildType)' == ''">Release</PayloadBuildType>
        <OutputPath>bin\$(Platform)\$(PayloadBuildType)\</OutputPath>
        <IntermediateOutputPath>obj\$(Platform)\$(PayloadBuildType)\</IntermediateOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <InstallerYear Include="19;20;21;22;23;24;25;26;27" />
        <BindPath Include="$(PayloadDir)" />
        <HarvestDirectory Include="$(PayloadDirSlash)">
            <ComponentGroupName>BundleFiles</ComponentGroupName>
            <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
            <SuppressRootDirectory>true</SuppressRootDirectory>
            <SuppressCom>true</SuppressCom>
            <SuppressRegistry>true</SuppressRegistry>
        </HarvestDirectory>
        <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
        <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
        <PackageReference Include="WixToolset.Heat" Version="4.0.6" />
    </ItemGroup>

    <Target Name="PrepareInstallerPayload"
            BeforeTargets="EnsurePayload"
            Condition="'$(SkipInstallerDependencyBuild)' != 'true'">
        <Message Importance="high"
                 Text="Building $(PayloadBuildType)A%(InstallerYear.Identity) for installer payload..." />
        <MSBuild Projects="$(PluginProject)"
                 Properties="Configuration=$(PayloadBuildType)A%(InstallerYear.Identity);Platform=x64;CoreConsoleDiagnostics=false;DisableAutoCADDeployment=true;RunAnalyzersDuringBuild=false;EnforceCodeStyleInBuild=false"
                 BuildInParallel="false" />
        <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;. '$(RepoRoot)tools\New-InstallerPayload.ps1'; New-InstallerPayloadFromYearBuilds -BuildType $(PayloadBuildType) -Destination '$(PayloadDir)' -Version $(Version)&quot;" />
    </Target>

    <Target Name="EnsurePayload" BeforeTargets="PrepareForBuild;HarvestDirectory">
        <Error Condition="!Exists('$(PayloadDir)\PackageContents.xml') Or !Exists('$(PayloadDir)\Contents')"
               Text="Installer payload missing at $(PayloadDir). Build this project with Configuration=Release (or Debug), or pass -p:PayloadDir=... -p:SkipInstallerDependencyBuild=true." />
    </Target>

    <Target Name="PublishMsiArtifact" AfterTargets="Build" Condition="'$(PublishMsi)' != 'false'">
        <PropertyGroup>
            <_MsiToPublish Condition="Exists('$(TargetDir)$(OutputName).msi')">$(TargetDir)$(OutputName).msi</_MsiToPublish>
            <_MsiToPublish Condition="'$(_MsiToPublish)' == '' And Exists('$(TargetDir)en-US\$(OutputName).msi')">$(TargetDir)en-US\$(OutputName).msi</_MsiToPublish>
        </PropertyGroup>
        <Error Condition="'$(_MsiToPublish)' == ''" Text="MSI was not produced under $(TargetDir)." />
        <MakeDir Directories="$(PublishMsiDir)" />
        <Copy SourceFiles="$(_MsiToPublish)"
              DestinationFiles="$(PublishMsiDir)$(OutputName)-$(Version).msi"
              OverwriteReadOnlyFiles="true" />
        <Message Importance="high"
                 Text="MSI ready: $(PublishMsiDir)$(OutputName)-$(Version).msi" />
    </Target>
</Project>
