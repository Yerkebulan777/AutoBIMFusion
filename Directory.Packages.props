<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="AutoCAD.NET" Version="$(AcadNetPackageVersion)" Condition="'$(AcadNetPackageVersion)' != ''" />
        <PackageVersion Include="AutoCAD.NET.Interop" Version="$(AcadInteropPackageVersion).*" Condition="'$(AcadInteropPackageVersion)' != ''" />
        <PackageVersion Include="Serilog" Version="4.0.0" />
        <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageVersion Include="Polyfill" Version="11.2.0" />
        <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
        <!-- Keep legacy dependency assembly versions aligned with Serilog 4.
             AutoCAD does not apply a plug-in DLL's binding redirects. -->
        <PackageVersion Include="System.Text.Json" Version="8.0.6" />
        <PackageVersion Include="System.Drawing.Common" Version="9.0.10" Condition="'$(Configuration)' != 'DebugA27' And '$(Configuration)' != 'ReleaseA27'" />
        <PackageVersion Include="System.Drawing.Common" Version="10.0.0" Condition="'$(Configuration)' == 'DebugA27' Or '$(Configuration)' == 'ReleaseA27'" />
    </ItemGroup>

</Project>
